# SakinaFinance - Environment Variables Template

# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-sakinafinance-enterprise-2026-v3-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com

# Database (Default: SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/sakinafinance

# Google OAuth2 (Required for Social Login)
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=votre-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-google-client-secret

# Stripe (Required for Payments)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI Configuration
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=votre-cle-gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash-lite,gemini-2.0-flash
GEMINI_CACHE_TTL=900
HUGGINGFACE_API_TOKEN=hf_...

# OCR Configuration
# native_pdf extrait les PDF texte; gemini_vision/openai_vision lisent images et scans;
# tesseract est un fallback local si le binaire système est installé.
OCR_PROVIDER_ORDER=native_pdf,gemini_vision,openai_vision,tesseract
OCR_GEMINI_MODEL=gemini-2.0-flash
OCR_OPENAI_MODEL=gpt-4o-mini
OCR_MAX_PDF_PAGES=6
OCR_MIN_PDF_TEXT_CHARS=160
OCR_TESSERACT_LANGUAGES=fra+eng

# Redis (Required for Celery)
REDIS_URL=redis://localhost:6379/0
